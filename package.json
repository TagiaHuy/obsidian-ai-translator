{
  "name": "ai-translator",
  "version": "1.0.0",
  "description": "Translate specific words to a target language using AI (Gemini, OpenAI, OpenRouter)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "TaGiaHuy",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@types/codemirror": "^5.60.17",
    "@types/node": "^16.11.29",
    "@typescript-eslint/utils": "^8.57.2",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.4.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.9.5",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "google-translate-api-browser": "^5.0.0"
  }
